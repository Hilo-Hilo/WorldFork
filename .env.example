# DO NOT COMMIT real keys — copy to .env and fill in real values
OPENROUTER_API_KEY=
ZEP_ENABLED=false
ZEP_API_KEY=

# Database / cache
DATABASE_URL=postgresql+asyncpg://worldfork:worldfork@localhost:5433/worldfork
DATABASE_URL_SYNC=postgresql+psycopg://worldfork:worldfork@localhost:5433/worldfork
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Run ledger
RUN_ROOT=/data/runs

# Provider defaults
DEFAULT_MODEL=deepseek/deepseek-v4-flash
FALLBACK_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3003
OPENROUTER_TITLE=WorldFork
OPENAI_CODEX_ENABLED=true
OPENAI_CODEX_OAUTH_TOKEN=
OPENAI_CODEX_AUTH_FILE=
OPENAI_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
OPENAI_CODEX_DEFAULT_MODEL=gpt-5.4
INITIALIZER_AGENT_MODEL=gpt-5.4
GOD_AGENT_MODEL=gpt-5.4
COHORT_AGENT_MODEL=deepseek/deepseek-v4-flash
HERO_AGENT_MODEL=deepseek/deepseek-v4-flash
EVENT_SUMMARY_MODEL=deepseek/deepseek-v4-flash
REPORT_AGENT_MODEL=gpt-5.4
LLM_MAX_RETRIES=10
LLM_RETRY_BACKOFF_SECONDS=1.5

# CORS
NEXT_ORIGIN=http://localhost:3003
CORS_ORIGINS=["http://localhost:3003"]

# Frontend (consumed by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8003
NEXT_PUBLIC_WS_URL=ws://localhost:8003

# Misc
LOG_LEVEL=INFO
ENVIRONMENT=development
AUTO_CREATE_TABLES=true
