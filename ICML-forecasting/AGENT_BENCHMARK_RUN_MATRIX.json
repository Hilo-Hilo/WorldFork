  "experiments": [
    {
      "id": "E0_card_qa",
      "required": true,
      "cases": "108 public + 36 private eval",
      "conditions": [
        "static_validation"
      ],
      "outputs": [
        "card_quality_report.md"
      ]
    },
    {
      "id": "E1_init_screen",
      "required": true,
      "cases": "existing_72_all + additional_36_all",
      "conditions": [
        "worldfork_init_only"
      ],
      "max_ticks": 1,
      "run_until_complete": false,
      "outputs": [
        "init_scores.csv",
        "worldfork_manifest.jsonl"
      ]
    },
    {
      "id": "E2_direct_baselines",
      "required": true,
      "cases": "resolved_24",
      "conditions": [
        "direct_llm",
        "structured_direct_llm"
      ],
      "no_web": true,
      "no_private_eval_until_scoring": true,
      "outputs": [
        "forecast_scores.csv",
        "direct_baseline_manifest.jsonl"
      ]
    },
    {
      "id": "E3_resolved_worldfork_short",
      "required": true,
      "cases": "resolved_24",
      "fallback_cases": "worldfork_resolved_core12_fallback",
      "model_route_policy": "icml_default_deepseek_v4_flash_cohort_hero",
      "conditions": [
        "worldfork_no_branch_short",
        "worldfork_branching_short"
      ],
      "max_ticks": 8,
      "tick_cap_semantics": "cap_not_target",
      "stop_on_ledger_path_mass_resolution": true,
      "outputs": [
        "forecast_scores.csv",
        "worldfork_manifest.jsonl"
      ]
    },
    {
      "id": "E4_long_horizon_audit",
      "required": true,
      "cases": "long_horizon_18",
      "fallback_cases": "minimum_long_horizon_6",
      "model_route_policy": "icml_default_deepseek_v4_flash_cohort_hero",
      "conditions": [
        "worldfork_full_branching_long"
      ],
      "max_ticks": 35,
      "minimum_ticks": 30,
      "tick_cap_semantics": "cap_not_target",
      "stop_on_ledger_path_mass_resolution": true,
      "outputs": [
        "audit_scores.csv",
        "social_state_scores.csv"
      ]
    },
    {
      "id": "E5_social_state_emotion_audit",
      "required": true,
      "cases": "long_horizon_18",
      "model_route_policy": "icml_default_deepseek_v4_flash_cohort_hero",
      "conditions": [
        "score_existing_long_runs"
      ],
      "outputs": [
        "social_state_scores.csv"
      ]
    },
    {
      "id": "S1_social_ablation",
      "required": false,
      "cases": "social_ablation_8",
      "model_route_policy": "icml_default_deepseek_v4_flash_cohort_hero",
      "conditions": [
        "worldfork_full_social_state",
        "worldfork_no_sociology_prompt_influence"
      ],
      "max_ticks": 20,
      "outputs": [
        "social_ablation_scores.csv"
      ]
    },
    {
      "id": "S2_branch_threshold_sweep",
      "required": false,
      "cases": "threshold_sweep_6",
      "model_route_policy": "icml_default_deepseek_v4_flash_cohort_hero",
      "conditions": [
        "threshold_0.55",
        "threshold_0.75",
        "threshold_0.95"
      ],
      "max_ticks": 20,
      "outputs": [
        "threshold_sweep.csv"
      ]
    }
  ],
  "branch_policies": {
    "init_only": {
      "max_branch_depth": 1,
      "max_active_multiverses": 1,
      "max_branches_per_tick": 1,
      "branch_score_threshold": 0.999
    },
    "worldfork_no_branch_short": {
      "max_branch_depth": 1,
      "max_active_multiverses": 1,
      "max_branches_per_tick": 1,
      "branch_score_threshold": 0.999
    },
    "worldfork_branching_short": {
      "max_branch_depth": 2,
      "max_active_multiverses": 4,
      "max_branches_per_tick": 1,
      "branch_score_threshold": 0.75
    },
    "worldfork_full_branching_long": {
      "max_branch_depth": 3,
      "max_active_multiverses": 8,
      "max_branches_per_tick": 2,
      "branch_score_threshold": 0.75
    },
    "threshold_sweep_template": {
      "max_branch_depth": 3,
      "max_active_multiverses": 8,
      "max_branches_per_tick": 2,
      "branch_score_threshold": "0.55|0.75|0.95"
    }
  },
  "primary_metrics": [
    "brier",
    "log_score",
    "unresolved_mass",
    "lineage_integrity",
    "branch_locality",
    "endpoint_coverage",
    "report_grounding",
    "social_state_consistency",
    "emotion_observability",
    "cost_usd",
    "llm_call_count"
  ],
  "do_not_claim": [
    "WorldFork predicts the future",
    "emotion model is validated psychology",
    "synthetic cases prove real-world accuracy",
    "branching improves accuracy without measured support"
  ]
}
