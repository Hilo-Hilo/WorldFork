  "default_model_route_policy": {
    "policy_id": "icml_default_deepseek_v4_flash_cohort_hero",
    "description": "Default ICML runtime policy. This is the standard condition for future E3/E4/E5 WorldFork runs, not an optional split-route ablation.",
    "cohort_agent": {
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash",
      "required_for_default_runs": true
    },
    "hero_agent": {
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash",
      "required_for_default_runs": true
    },
    "governance_report_routes": {
      "routes": [
        "initializer_agent",
        "god_agent",
        "endpoint_ledger",
        "report_agent"
      ],
      "model_policy": "Use a strong configured governance/report route such as openai-codex/gpt-5.4 or an OpenRouter-hosted Kimi/Claude model."
    },
    "comparability_note": "Rows produced with Codex-only routing are smoke/ablation rows and must be reported separately from default ICML route-policy rows."
  },
  "stopping_policy": {
    "tick_counts_are_caps": true,
    "stopping_criterion": "endpoint-ledger and path-mass resolution",
    "resume_reuse_required": "Reuse existing Big Bangs, jobs, and artifacts when unresolved or insufficient path mass remains; do not reinitialize unless the source run is unusable.",
    "default_high_volume_route": "OpenRouter deepseek/deepseek-v4-flash for cohort_agent and hero_agent in default ICML runtime rows."
  },
