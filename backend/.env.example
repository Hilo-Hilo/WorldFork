DATABASE_URL=postgresql+psycopg://worldfork:worldfork@localhost:5432/worldfork
ARTIFACT_ROOT=../artifacts
SOURCE_OF_TRUTH_DIR=../source_of_truth
AUTO_CREATE_TABLES=false
OPENROUTER_API_KEY=
DEFAULT_LLM_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_COMPLETIONS_URL=https://openrouter.ai/api/v1/chat/completions
OPENAI_CODEX_ENABLED=true
OPENAI_CODEX_OAUTH_TOKEN=
OPENAI_CODEX_AUTH_FILE=~/.worldfork/openai-codex-auth.json
OPENAI_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
OPENAI_CODEX_DEFAULT_MODEL=gpt-5.4
REDIS_URL=redis://localhost:6379/0
DEFAULT_MODEL=deepseek/deepseek-v4-flash
FALLBACK_MODEL=deepseek/deepseek-v4-flash
INITIALIZER_AGENT_MODEL=gpt-5.4
GOD_AGENT_MODEL=gpt-5.4
COHORT_AGENT_MODEL=deepseek/deepseek-v4-flash
HERO_AGENT_MODEL=deepseek/deepseek-v4-flash
EVENT_SUMMARY_MODEL=deepseek/deepseek-v4-flash
REPORT_AGENT_MODEL=gpt-5.4
INITIALIZER_DIRECT_CONTEXT_CHAR_BUDGET=18000
INITIALIZER_CHUNK_CHARS=12000
INITIALIZER_CHUNK_OVERLAP_CHARS=800
LLM_MAX_RETRIES=10
LLM_RETRY_BACKOFF_SECONDS=1.5
